# 참고용입니다. Python은 이 파일을 자동으로 읽지 않습니다.
# GitHub에서는 Settings > Secrets and variables > Actions > Repository secrets에 등록하세요.
GEMINI_API_KEY=
# 선택: GitHub Repository variables로 지정할 수 있습니다.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_HOT_MODEL=gemini-3.8-flash

# Optional: public NVD API works without this key. Keep keys out of Git.
NVD_API_KEY=
