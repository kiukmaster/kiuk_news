{
  "name": "kiuk-news-scheduler",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  // GITHUB_TOKEN is a Cloudflare Secret; never place its value in this file.
  "vars": {
    "GITHUB_REPOSITORY": "kiukmaster/kiuk_news",
    "GITHUB_REF": "main"
  },
  // Cloudflare Cron is UTC. :07 dispatches; :27 and :47 recover a missing or failed run.
  "triggers": {
    "crons": [
      "7 20 * * *", "27 20 * * *", "47 20 * * *",
      "7 3 * * *", "27 3 * * *", "47 3 * * *",
      "7 9 * * *", "27 9 * * *", "47 9 * * *"
    ]
  }
}
